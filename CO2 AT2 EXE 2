#include <iostream>
using namespace std;

class Member
{
private:
    int memberID;
    string name, planType;
    double fee;

public:
    static int totalMembers;

    bool validPlan(string plan)
    {
        return (plan == "Basic" ||
                plan == "Premium" ||
                plan == "VIP");
    }

    void input()
    {
        cout << "Member ID: ";
        cin >> memberID;

        cout << "Name: ";
        cin >> name;

        cout << "Plan (Basic/Premium/VIP): ";
        cin >> planType;

        if (!validPlan(planType))
        {
            cout << "Invalid Plan!\n";
            fee = 0;
            return;
        }

        calculateFee();
        totalMembers++;
    }

    void calculateFee()
    {
        if (planType == "Basic")
            fee = 1000;
        else if (planType == "Premium")
            fee = 2000;
        else if (planType == "VIP")
            fee = 3000;
    }

    void display()
    {
        cout << "\nID: " << memberID
             << "\nName: " << name
             << "\nPlan: " << planType
             << "\nFee: Rs." << fee << endl;
    }
};

int Member::totalMembers = 0;

int main()
{
    int n;
    cout << "Enter number of members: ";
    cin >> n;

    Member m[100];

    for (int i = 0; i < n; i++)
        m[i].input();

    cout << "\nMember Details\n";
    for (int i = 0; i < n; i++)
        m[i].display();

    cout << "\nTotal Active Members: "
         << Member::totalMembers;
}
