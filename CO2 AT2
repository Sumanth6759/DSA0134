#include <iostream>
using namespace std;

class Violation
{
private:
    string vehicleNo, ownerName, violationType;
    double fineAmount;

public:
    static int totalViolations;

    bool validViolation(string type)
    {
        return (type == "SignalJump" ||
                type == "NoHelmet" ||
                type == "Overspeed");
    }

    void input()
    {
        cout << "Vehicle Number: ";
        cin >> vehicleNo;

        cout << "Owner Name: ";
        cin >> ownerName;

        cout << "Violation Type (SignalJump/NoHelmet/Overspeed): ";
        cin >> violationType;

        if (!validViolation(violationType))
        {
            cout << "Invalid Violation Type!\n";
            fineAmount = 0;
            return;
        }

        calculateFine();
        totalViolations++;
    }

    void calculateFine()
    {
        if (violationType == "SignalJump")
            fineAmount = 1000;
        else if (violationType == "NoHelmet")
            fineAmount = 500;
        else if (violationType == "Overspeed")
            fineAmount = 1500;
    }

    void display()
    {
        cout << "\nVehicle: " << vehicleNo
             << "\nOwner: " << ownerName
             << "\nViolation: " << violationType
             << "\nFine: Rs." << fineAmount << endl;
    }
};

int Violation::totalViolations = 0;

int main()
{
    int n;
    cout << "Enter number of violations: ";
    cin >> n;

    Violation v[100];

    for (int i = 0; i < n; i++)
        v[i].input();

    cout << "\nViolation Report\n";
    for (int i = 0; i < n; i++)
        v[i].display();

    cout << "\nTotal Violations: "
         << Violation::totalViolations;
}
